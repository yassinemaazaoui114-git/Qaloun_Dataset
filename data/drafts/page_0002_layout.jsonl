{"page": 2, "line": 11, "type": "ayah_line", "surah": 2, "juz": 1, "is_centered": false, "text": "ٱلَّذِينَ يُؤْمِنُونَ بِٱلْغَيْبِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا", "first_word_id": 34, "last_word_id": 39}
{"page": 2, "line": 12, "type": "ayah_line", "surah": 2, "juz": 1, "is_centered": false, "text": "رَزَقْنَٰهُمْ يُنفِقُونَ ﴿2﴾ وَٱلَّذِينَ يُؤْمِنُونَ بِمَا أُنزِلَ", "first_word_id": 40, "last_word_id": 45}
{"page": 2, "line": 13, "type": "ayah_line", "surah": 2, "juz": 1, "is_centered": false, "text": "إِلَيْكَ وَمَا أُنزِلَ مِن قَبْلِكَ وَبِٱلْـَٔاخِرَةِ هُمْ يُوقِنُونَ ﴿3﴾", "first_word_id": 46, "last_word_id": 53}
{"page": 2, "line": 14, "type": "ayah_line", "surah": 2, "juz": 1, "is_centered": false, "text": "أُوْلَـٰٓئِكَ عَلَىٰ هُدًى مِّن رَّبِّهِمْ ۖ وَأُوْلَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ﴿4﴾", "first_word_id": 54, "last_word_id": 61}
